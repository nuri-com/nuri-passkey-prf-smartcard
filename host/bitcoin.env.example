# Nuri Card Chrome wallet: Bitcoin settings for the native host.
# Copy to ~/.nuri-card-host/bitcoin.env and edit. Public values only.
# Never put a PIN here: the PIN is typed in the approval popup.

# Nuri cosigner (the server half of the MuSig2 2-of-2).
NURI_ARKADE_SIGNER_URL=https://arkade.nuri.com

# Which MuSig2 applet on the card holds your wallet key.
# AID3 (fast, v1.17) = 4E5552494D55473301, AID2 = 4E5552494D55473201, AID1 = 4E5552494D554701
NURI_MUSIG2_AID=4E5552494D55473301

# Your card's FIDO2 credential id (base64url) that the Nuri server registered for this wallet.
# Leave empty to show addresses read-only; required for receive and send.
NURI_CARD_CREDENTIAL=

# Exact PC/SC reader name that holds the card (see: scripts/nuri_pcsc.py, docs/reader-compatibility.md).
# The OMNIKEY 5422 has two: "...Smartcard Reader" (contact) and "...Smartcard Reader 01" (contactless/top).
NURI_READER=HID Global OMNIKEY 5422 Smartcard Reader

# Optional safety pin: fail closed if the derived wallet is not this ark address.
NURI_CARD_EXPECT_ARK=
