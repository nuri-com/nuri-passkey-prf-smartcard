<?xml version="1.0" encoding="UTF-8"?>
<project name="NuriVault" default="build" basedir=".">
    <description>Build the PIN-gated on-card vault (MIT, SHA256-only HMAC)</description>
    <property name="ajc.jar" location="../../tools/ant-javacard-proven.jar"/>
    <taskdef name="javacard" classname="pro.javacard.ant.JavaCard" classpath="${ajc.jar}"/>
    <fail unless="jckit.path" message="Pass -Djckit.path=/absolute/path/to/jc304_kit"/>
    <property name="cap.output" location="../../dist/nuri-vault.cap"/>
    <target name="build">
        <javacard jckit="${jckit.path}">
            <cap aid="4E555249564C54" version="1.1" output="${cap.output}" sources="." jca="3.0.4">
                <applet class="com.nuri.vault.NuriVault" aid="4E555249564C5401"/>
            </cap>
        </javacard>
    </target>
</project>
