<?xml version="1.0" encoding="UTF-8"?>
<project name="NuriEthSignerV2" default="build" basedir=".">
    <description>Build NuriEthSignerV2 applet CAP (package 4E55524945544832 "NURIETH2", applet 4E5552494554483201)</description>

    <property name="ajc.jar" location="../../tools/ant-javacard-proven.jar"/>
    <taskdef name="javacard" classname="pro.javacard.ant.JavaCard" classpath="${ajc.jar}"/>

    <fail unless="jckit.path" message="Pass -Djckit.path=/absolute/path/to/jc304_kit"/>
    <property name="cap.output" location="../../dist/nuri-eth2-signer.cap"/>

    <target name="build">
        <javacard jckit="${jckit.path}">
            <cap aid="4E55524945544832" version="2.1" output="${cap.output}" sources="." jca="3.0.4">
                <applet class="com.nuri.eth2.NuriEthSignerV2" aid="4E5552494554483201"/>
            </cap>
        </javacard>
    </target>
</project>
