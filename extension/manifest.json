{
  "manifest_version": 3,
  "name": "Nuri Card",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "EIP-1193 wallet provider backed by the Nuri Card's on-card Ethereum key (via native messaging host com.nuri.card).",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://mainnet.base.org/*", "https://cloudflare-eth.com/*", "https://sepolia.base.org/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Nuri Card" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "128": "icon128.png" }
}
